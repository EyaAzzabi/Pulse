# Copy this file to backend/.env and adjust as needed. Every value below has a
# safe local default — PULSE runs fully offline (deterministic financial engine
# + SQLite) with none of these set.

APP_NAME=Pulse AI
ENVIRONMENT=development

# SQLite is the default for local development. For Postgres in production use:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/pulse
DATABASE_URL=sqlite:///./pulse.db

JWT_SECRET=change-this-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM provider: "groq" | "openai" | "none". Leave as "none" (or unset) to run
# the copilot fully offline — it still answers using the deterministic
# financial engine, just without natural-language rephrasing.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
LLM_BASE_URL=

# n8n automation (optional). Without this, approved actions are queued and
# clearly marked as not dispatched instead of being silently skipped.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# SMTP (optional, not yet wired to a transport in this phase — see
# docs/FEATURE_STATUS.md).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Used only by scripts/seed_demo.py to make the demo password reproducible in
# CI. Leave unset locally — a random password is generated and printed once.
DEMO_USER_PASSWORD=
