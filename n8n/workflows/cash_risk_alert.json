{
  "name": "Pulse AI - Cash Risk Alert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "pulse/cash-risk-alert",
        "responseMode": "responseNode",
        "options": {},
        "authentication": "headerAuth"
      },
      "id": "webhook-trigger",
      "name": "Webhook: Cash Risk Alert",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ON_IMPORT",
          "name": "Pulse webhook secret"
        }
      },
      "webhookId": "ae46386c-e66c-5416-ae1f-6332dfe57d18"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{$json.body.action_type}}",
              "rightValue": "cash_risk_alert",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "filter-action-type",
      "name": "Is cash_risk_alert?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{$env.PULSE_EMAIL_FROM}}",
        "toEmail": "={{$json.body.details.recipient_email}}",
        "subject": "=Pulse AI - cash risk detected ({{$json.body.details.risk_level}})",
        "text": "={{$json.body.details.message}}\n\nEvidence: {{JSON.stringify($json.body.details.evidence)}}",
        "options": {},
        "emailFormat": "text"
      },
      "id": "send-email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        680,
        240
      ],
      "credentials": {
        "smtp": {
          "id": "SMTP_CREDENTIAL_ID",
          "name": "Pulse SMTP"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { completed: false, sent: false, reason: \"Unsupported action type\" } }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "noop-ignored",
      "name": "Ignored (not this workflow)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        680,
        400
      ]
    },
    {
      "id": "delivery-receipt",
      "name": "Confirm Workflow Completion",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        900,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { completed: true, sent: true, message_id: $json.messageId || $json.id || null, status: $json.status || null } }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Webhook: Cash Risk Alert": {
      "main": [
        [
          {
            "node": "Is cash_risk_alert?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is cash_risk_alert?": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Ignored (not this workflow)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email": {
      "main": [
        [
          {
            "node": "Confirm Workflow Completion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Africa/Tunis",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveExecutionProgress": false,
    "saveManualExecutions": false
  },
  "triggerCount": 1,
  "_pulse_notes": "Authenticated receiver for explicitly supplied risk alerts; the backend does not automatically emit threshold events yet."
}
