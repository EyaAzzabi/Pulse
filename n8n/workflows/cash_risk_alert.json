{
  "name": "Pulse AI - Cash Risk Alert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "pulse/cash-risk-alert",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook: Cash Risk Alert",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{$json.action_type}}",
              "rightValue": "cash_risk_alert",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "filter-action-type",
      "name": "Is cash_risk_alert?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "fromEmail": "alerts@pulse.ai",
        "toEmail": "={{$json.details.recipient_email}}",
        "subject": "Pulse AI — cash risk detected ({{$json.details.risk_level}})",
        "text": "={{$json.details.message}}\n\nEvidence: {{JSON.stringify($json.details.evidence)}}",
        "options": {}
      },
      "id": "send-email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [680, 240],
      "credentials": { "smtp": { "id": "SMTP_CREDENTIAL_ID", "name": "Pulse SMTP" } }
    },
    {
      "parameters": {},
      "id": "noop-ignored",
      "name": "Ignored (not this workflow)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [680, 400]
    }
  ],
  "connections": {
    "Webhook: Cash Risk Alert": { "main": [[{ "node": "Is cash_risk_alert?", "type": "main", "index": 0 }]] },
    "Is cash_risk_alert?": {
      "main": [
        [{ "node": "Send Email", "type": "main", "index": 0 }],
        [{ "node": "Ignored (not this workflow)", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "triggerCount": 1,
  "_pulse_notes": "Pulse's backend POSTs { action_type, details } to this webhook URL (see N8N_WEBHOOK_URL) when a forecast crosses a configured risk threshold. Import this file via n8n UI > Workflows > Import from File, then attach a real SMTP credential before activating."
}
